    },
    {
      "name": "checkbox",
      "type": "registry:component",
      "title": "Checkbox",
      "description": "Brandbook-styled checkbox with lilac checked state.",
      "registryDependencies": ["utils"],
      "dependencies": ["@radix-ui/react-checkbox", "lucide-react"],
      "files": [{ "path": "packages/ui/src/components/brand/checkbox.tsx", "type": "registry:component" }]
    },
    {
      "name": "dialog",
      "type": "registry:ui",
      "title": "Dialog",
