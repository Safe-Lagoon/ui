    },
    {
      "name": "table",
      "type": "registry:ui",
      "title": "Table",
      "description": "Semantic table primitives for data display.",
      "registryDependencies": ["utils"],
      "files": [{ "path": "packages/ui/src/components/ui/table.tsx", "type": "registry:ui" }]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
